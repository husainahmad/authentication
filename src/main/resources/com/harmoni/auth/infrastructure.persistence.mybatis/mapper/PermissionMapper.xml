<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.harmoni.auth.infrastructure.persistence.mybatis.mapper.PermissionMapper">

  <resultMap id="BaseResultMap" type="com.harmoni.auth.domain.model.Permission">
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="name" jdbcType="VARCHAR" property="name" />
  </resultMap>

  <sql id="Base_Column_List">
    id, name
  </sql>

  <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
    select 
    <include refid="Base_Column_List" />
    from permissions
    where id = #{id,jdbcType=BIGINT}
  </select>

  <select id="selectByName" parameterType="java.lang.String" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from permissions
    where name = #{name,jdbcType=VARCHAR}
  </select>

  <select id="selectAll" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from permissions
  </select>

  <select id="selectPermissionsByRoleId" parameterType="java.lang.Long" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from permissions
    where id in (
        select permission_id from role_permissions where role_id = #{roleId,jdbcType=BIGINT}
    )
  </select>

  <select id="selectPermissionsByUserId" parameterType="java.lang.Long" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from permissions
    where id in (
        select permission_id from role_permissions 
        where role_id in (
            select role_id from user_roles where user_id = #{userId,jdbcType=BIGINT}
        )
    )
  </select>

  <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
    delete from permissions
    where id = #{id,jdbcType=BIGINT}
  </delete>

  <insert id="insert" parameterType="com.harmoni.auth.domain.model.Permission">
    <selectKey keyProperty="id" order="AFTER" resultType="java.lang.Long">
      SELECT LAST_INSERT_ID()
    </selectKey>
    insert into permissions (name)
    values (#{name,jdbcType=VARCHAR})
  </insert>

  <update id="updateByPrimaryKey" parameterType="com.harmoni.auth.domain.model.Permission">
    update permissions
    set name = #{name,jdbcType=VARCHAR}
    where id = #{id,jdbcType=BIGINT}
  </update>

</mapper>
