<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.harmoni.auth.infrastructure.persistence.mybatis.mapper.RefreshTokenMapper">

  <resultMap id="BaseResultMap" type="com.harmoni.auth.domain.model.RefreshToken">
    <id column="id" property="id" jdbcType="BIGINT" />
    <result column="token" property="token" jdbcType="VARCHAR" />
    <result column="user_id" property="userId" jdbcType="BIGINT" />
    <result column="expires_at" property="expiryDate" jdbcType="TIMESTAMP" />
  </resultMap>

  <sql id="Base_Column_List">
    id, token, user_id, expires_at
  </sql>

  <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
    select
     <include refid="Base_Column_List" />
    from refresh_tokens
    where id = #{id,jdbcType=BIGINT}
  </select>

  <select id="selectByToken" parameterType="java.lang.String" resultMap="BaseResultMap">
    select
     <include refid="Base_Column_List" />
    from refresh_tokens
    where token = #{token,jdbcType=VARCHAR}
  </select>

  <select id="selectByUserId" parameterType="java.lang.Long" resultMap="BaseResultMap">
    select
     <include refid="Base_Column_List" />
    from refresh_tokens
    where user_id = #{userId,jdbcType=BIGINT}
  </select>

  <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
    delete from refresh_tokens
    where id = #{id,jdbcType=BIGINT}
  </delete>

  <insert id="insert" parameterType="com.harmoni.auth.domain.model.RefreshToken">
    <selectKey keyProperty="id" order="AFTER" resultType="java.lang.Long">
      SELECT LAST_INSERT_ID()
    </selectKey>
    insert into refresh_tokens (token, user_id, expires_at)
    values (#{token,jdbcType=VARCHAR}, #{userId,jdbcType=BIGINT}, #{expiryDate,jdbcType=TIMESTAMP})
  </insert>

  <update id="updateByPrimaryKey" parameterType="com.harmoni.auth.domain.model.RefreshToken">
    update refresh_tokens
    set token = #{token,jdbcType=VARCHAR},
        user_id = #{userId,jdbcType=BIGINT},
        expires_at = #{expiryDate,jdbcType=TIMESTAMP}
    where id = #{id,jdbcType=BIGINT}
  </update>

  <delete id="deleteByToken" parameterType="java.lang.String">
    delete from refresh_tokens
    where token = #{token,jdbcType=VARCHAR}
  </delete>

  <delete id="deleteExpired" parameterType="java.util.Date">
    delete from refresh_tokens
    where expires_at &lt; #{date,jdbcType=TIMESTAMP}
  </delete>
</mapper>
