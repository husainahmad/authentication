    </selectKey>
    insert into refresh_tokens (token, username, expiry_date)
    values (#{token,jdbcType=VARCHAR}, #{username,jdbcType=VARCHAR}, #{expiryDate,jdbcType=TIMESTAMP})
  </insert>

  <update id="updateByPrimaryKey" parameterType="com.harmoni.auth.domain.model.RefreshToken">
    update refresh_tokens
    set token = #{token,jdbcType=VARCHAR},
        username = #{username,jdbcType=VARCHAR},
        expiry_date = #{expiryDate,jdbcType=TIMESTAMP}
